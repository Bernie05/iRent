# iRent API (server/) configuration. Copy to server/.env and fill in. NEVER commit real values.
# NFR10: every secret and placeholder comes from here.

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the Express API listens on (default 4000).
PORT=4000
# Number of reverse proxies in front of the API (0 locally; usually 1 on a PaaS) so the
# rate limiter sees the real client IP.
TRUST_PROXY=0

# --- Supabase ----------------------------------------------------------------
# Local values come from `npm run db:env` (repo root) after `npm run db:start`:
#   API_URL -> SUPABASE_URL, ANON_KEY -> SUPABASE_ANON_KEY, SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
# SERVER ONLY. Bypasses RLS. Never put this in the client or in a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Browser client ---------------------------------------------------------
# Exact origin(s) of the React client, comma-separated. CORS allows only these, and invite /
# reset links redirect to <first origin>/set-password.
CLIENT_ORIGIN=http://localhost:5173

# --- Email ---------------------------------------------------------------------
# log    = write each email to the console and server/.mail/*.json (dev and QA; no account needed)
# resend = deliver through Resend (needs RESEND_API_KEY and a verified sending domain)
EMAIL_TRANSPORT=log
# Required only when EMAIL_TRANSPORT=resend.
RESEND_API_KEY=
# Sender shown on every email (placeholder until the domain is verified, OI-9).
EMAIL_FROM=iRent <no-reply@example.com>
# Where admin notices (new payment uploads) go (placeholder, OI-9).
ADMIN_NOTIFY_EMAIL=owner@example.com
# Optional: absolute URL of the logo used in emails. Default: <CLIENT_ORIGIN>/logo.png
EMAIL_LOGO_URL=
# Optional: directory for the log transport (default: server/.mail).
MAIL_LOG_DIR=

# --- Test clock (D-12) --------------------------------------------------------
# Only for local/staging testing. The server refuses to start if ALLOW_CLOCK_OVERRIDE=true
# and NODE_ENV=production.
ALLOW_CLOCK_OVERRIDE=false
# ISO 8601 instant used as "now" when the override is allowed, e.g. 2026-09-30T16:30:00Z
CLOCK_OVERRIDE=

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info
