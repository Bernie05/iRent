# iRent client environment (NFR10). Copy to `.env.local` and fill in.
# Everything here is PUBLIC: it is compiled into the browser bundle.
# Never put the Supabase service-role key or any other secret in this file.

# Express API base URL (the server mounts every route under /api).
VITE_API_URL=http://localhost:4000/api

# Supabase project (local CLI default shown). Anon key only.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public contact number (R7). PLACEHOLDER until Bernie supplies the real one.
VITE_CONTACT_PHONE=+63 917 000 0000

# true = run against the MSW mocks of the frozen API contract (no server or Supabase needed).
# `npm run dev:mocks` loads .env.mocks, which sets this to true.
VITE_USE_MOCKS=false
